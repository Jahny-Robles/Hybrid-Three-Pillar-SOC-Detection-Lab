# =============================================================
# Hybrid-Three-Pillar-SOC-Detection-Lab — .gitignore
# Purpose: nothing sensitive ever enters git history. This file
# must exist in the repo root BEFORE the first `git add`.
# The 🔴 files below are the-file-IS-the-secret: excluded, never scrubbed.
#
# Patterns are deliberately PRECISE rather than broad. In a security
# repo, a bare *credential* / *secret* / *password* / *onboard* wildcard
# silently swallows legitimate published content — detection rules for
# credential access, LSASS/secretsdump writeups, password-policy docs,
# onboarding screenshots. Git skips them with no error, so the loss is
# invisible. Match the artifact, not the vocabulary.
# =============================================================

# ---- Private keys / SSH ------------------------------------
*.key
*.pem
*.ppk
*.pfx
*.p12
id_rsa*
id_ed25519*
known_hosts

# ---- Credential & secret dumps -----------------------------
# Precise: real secret files, not any filename mentioning the topic.
SOC_LAB_info.txt
*.token
.env
.env.*
secrets.*
*.secret
*.secrets
*-secrets.json
*-secrets.yml
*-secrets.yaml
*_secret.*
*_secrets.*
*_credentials.*
*-credentials.json
*-credentials.csv
credentials.json
credentials.csv
credentials.txt
passwords.txt
passwords.csv
*.kdbx
*.ovpn

# ---- Microsoft Defender / MDE onboarding packages ----------
# The PACKAGE is the secret; docs and screenshots about onboarding are not.
WindowsDefenderATPOnboardingPackage*
*OnboardingPackage*
*OnboardingScript*
WindowsDefenderATPLocalOnboardingScript*

# ---- Azure Arc onboarding scripts (subscription + tenant IDs)
OnboardingScript*.ps1
azcmagent-onboard*.ps1

# ---- Lab automation config (tenant + subscription IDs) -----
# The .example version IS committed; the real one never is.
config/lab-config.json
**/lab-config.json
!**/lab-config.example.json

# ---- Kerberos / hash / capture artifacts -------------------
# Real cracked material and captures from lab exercises.
*.kirbi
*.ccache
*.ntds
*.pcap
*.pcapng
*.hashes
*.hccapx
hashes.txt
*krb5tgs*

# ---- Archives (often bundle the above) ---------------------
*.zip
*.7z
*.tar
*.tar.gz
*.tgz
*.rar

# ---- Large media — keep the repo lean ----------------------
# Publish select cropped stills instead of raw recordings.
*.mp4
*.mov
*.avi
*.mkv
*.webm

# ---- Safe staging area for raw/unscrubbed working files ----
# Drop anything not-yet-scrubbed in here; git will never see it.
_local/
scratch/
raw/
samples/raw/

# ---- Real email specimens (email-triage folder) ------------
# Redacted headers ARE committed; raw specimens never are.
email-triage/cases/
*.eml
*.msg

# ---- OS / editor cruft -------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/

# =============================================================
# NOTE on the 🟡 scrub-then-commit files (ARM templates, the
# session log, README/runbook/.docx): these are NOT ignored on
# purpose — they belong in the repo, but ONLY in scrubbed form.
# Workflow: keep the raw copy in _local/, scrub a copy into the
# real repo folder, then commit the scrubbed copy. The final
# pre-push grep check is your last line of defense for these.
# =============================================================
